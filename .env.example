# Copiar a .env y ajustar según el entorno.

# --- Postgres ---
# Sin estas vars, src/db.ts usa localhost:5432/psyeva1 postgres/admin.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=psyeva1
DB_USER=postgres
DB_PASSWORD=admin
DB_SSL=false

# --- Storage (S3-compatible) ---
# Local: MinIO vía `docker compose up -d` (ver docker-compose.yml).
# Producción (Railway): usar el endpoint/credenciales del bucket de Railway.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=psyeva-reportes
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
# path-style (http://host/bucket/key) — requerido por MinIO y por los
# buckets S3-compatible de Railway, que no soportan el estilo por subdominio.
S3_FORCE_PATH_STYLE=true
# Opcional: base pública si difiere del endpoint de la API S3 (típico en
# Railway, donde el endpoint interno y el dominio público no son el mismo).
# Si no se define, se usa S3_ENDPOINT.
# S3_PUBLIC_URL=https://bucket-production-xxxx.up.railway.app
