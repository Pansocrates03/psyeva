# Copiar a .env y ajustar según el entorno.

# --- Postgres ---
# Sin estas vars, src/db.ts usa localhost:5432/psyeva1 postgres/admin.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=psyeva1
DB_USER=postgres
DB_PASSWORD=admin
DB_SSL=false

# --- Administrador ---
ADMIN_PASSWORD=admin

# --- Storage (S3-compatible) ---
# Local: MinIO vía `docker compose up -d` (ver docker-compose.yml).
# Producción (Railway): usar el endpoint/credenciales del bucket de Railway.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=psyeva-reportes
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
# path-style (http://host/bucket/key) — requerido por MinIO y por los
# buckets S3-compatible de Railway, que no soportan el estilo por subdominio.
S3_FORCE_PATH_STYLE=true
# El bucket es privado — toda lectura pasa por una URL firmada de vida
# corta (ver src/services/storageService.ts: getObjectUrl/resolveUrl), no
# por una URL pública fija. S3_PUBLIC_URL importa en serio acá: es el host
# que queda grabado en esa URL firmada, así que tiene que ser uno que el
# navegador del usuario pueda resolver. En Railway el endpoint interno
# (S3_ENDPOINT) normalmente NO es ese host — si se deja sin definir acá,
# las URLs firmadas en producción apuntan a un host solo alcanzable dentro
# de la red privada de Railway y quedan rotas para cualquiera de afuera.
# En local (MinIO) se puede dejar sin definir: usa S3_ENDPOINT.
# S3_PUBLIC_URL=https://bucket-production-xxxx.up.railway.app
# Duración de una URL firmada, en segundos. Default 3600 (1 hora).
# S3_SIGNED_URL_TTL=3600
